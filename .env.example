# EveBench process-pool settings
#
# EVEBENCH_MAX_WORKERS defaults to min(4, available CPU cores).
EVEBENCH_MAX_WORKERS=4
EVEBENCH_MAX_TASKS_PER_WORKER=25

# SQLite database used for persisted benchmark results and the leaderboard.
EVEBENCH_RESULTS_DB=data/evebench.sqlite

# Logging
#
# Console logs are concise text. Rotating file logs are structured JSON Lines.
# Set EVEBENCH_LOG_FILE to an empty value to disable file logging.
EVEBENCH_LOG_FILE=logs/evebench.jsonl
EVEBENCH_LOG_LEVEL=DEBUG
EVEBENCH_CONSOLE_LOG_LEVEL=INFO
EVEBENCH_LOG_CONSOLE=true
EVEBENCH_LOG_MAX_BYTES=10485760
EVEBENCH_LOG_BACKUP_COUNT=5

# Shared Python interpreter override
#
# VeriEQL inherits this value unless EVEBENCH_VERIEQL_PYTHON is set.
# EVEBENCH_PYTHON=/absolute/path/to/python

# SQLSolver
#
# The defaults use the vendored baseline under baselines/SQLSolver.
# Use absolute paths when overriding these values.
# EVEBENCH_SQLSOLVER_JAR=/absolute/path/to/sqlsolver-v1.1.0.jar
# EVEBENCH_SQLSOLVER_LIB=/absolute/path/to/SQLSolver/lib
# EVEBENCH_SQLSOLVER_WORKDIR=/absolute/path/to/SQLSolver

# SPES
#
# The defaults use the vendored baseline under baselines/spes and the native
# libraries under baselines/SQLSolver/lib.
# EVEBENCH_SPES_JAR=/absolute/path/to/equitas-1.0-SNAPSHOT.jar
# EVEBENCH_SPES_LIB=/absolute/path/to/SQLSolver/lib
# EVEBENCH_SPES_WORKDIR=/absolute/path/to/spes
# EVEBENCH_JAVA=/absolute/path/to/java

# QED
#
# Build both baselines/qed/parser and baselines/qed/prover; z3 and cvc5
# must be on PATH. Java defaults to JAVA19_HOME/bin/java when set,
# otherwise EVEBENCH_JAVA or java.
# EVEBENCH_QED_PARSER_JAR=/absolute/path/to/qed-parser-1.0-SNAPSHOT-jar-with-dependencies.jar
# EVEBENCH_QED_PROVER=/absolute/path/to/qed-prover
# EVEBENCH_QED_JAVA=/absolute/path/to/java19/bin/java

# VeriEQL
#
# The defaults use the vendored baseline under baselines/VeriEQL, the current
# Python interpreter, and the native libraries under baselines/SQLSolver/lib.
# EVEBENCH_VERIEQL_ROOT=/absolute/path/to/VeriEQL
# EVEBENCH_VERIEQL_Z3_LIB=/absolute/path/to/SQLSolver/lib
# EVEBENCH_VERIEQL_PYTHON=/absolute/path/to/python
EVEBENCH_VERIEQL_BOUND_SIZE=2

# XData
#
# The default uses the vendored baseline under baselines/xdata and its bundled
# Z3. XData needs a PostgreSQL database; see
# baselines/xdata/installer/xdata_db.sql. Percent-encode special characters in
# the password. backend_options.xdata.connection_string overrides it per run.
# EVEBENCH_XDATA_ROOT=/absolute/path/to/xdata
# EVEBENCH_XDATA_CONNECTION_STRING=postgresql://testuser:Testuser%40123@127.0.0.1:5432/xdatadb
# EVEBENCH_XDATA_JAVA=/absolute/path/to/java
# EVEBENCH_XDATA_PYTHON=/absolute/path/to/python

# Agentic dataset generator
#
# ANTHROPIC_WORKSPACE_ID is needed when the Anthropic key is not scoped to one
# workspace. Copy the ID from the Anthropic Console workspace settings page.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# NearMiss reads these from .env when they are not already in the process environment.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# OpenAI-compatible LLM counterexample checker
#
# The LLM checker is registered when EVEBENCH_LLM_MODEL is set. API keys are
# optional for local endpoints; EVEBENCH_LLM_API_KEY falls back to
# OPENAI_API_KEY.
# EVEBENCH_LLM_MODEL=gpt-5.6-terra
# EVEBENCH_LLM_BASE_URL=https://api.openai.com/v1
# EVEBENCH_LLM_API_KEY=
# EVEBENCH_LLM_REASONING_EFFORT=medium
# EVEBENCH_LLM_MAX_COMPLETION_TOKENS=4096
